# Copy to .env for local development. Replace placeholders locally; never commit .env.
DJANGO_ENV=development
DJANGO_SECRET_KEY=replace-with-a-random-secret
DEBUG=true
ALLOWED_HOSTS=sscentrepreneur.com,www.sscentrepreneur.com,localhost,127.0.0.1
FORCE_SCRIPT_NAME=
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# MySQL connection
DB_ENGINE=django.db.backends.mysql
DB_NAME=replace-with-database-name
DB_USER=replace-with-database-user
DB_PASSWORD=replace-with-database-password
DB_HOST=127.0.0.1
DB_PORT=3306

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=replace-with-sender-address

# Third-party integrations
SENDINBLUE_API_KEY=replace-with-provider-api-key
RAZORPAY_KEY_ID=replace-with-razorpay-key-id
RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret
PSPDFKIT_API_KEY=replace-with-pspdfkit-api-key
RECAPTCHA_SITE_KEY=replace-with-recaptcha-site-key
RECAPTCHA_SECRET_KEY=replace-with-recaptcha-secret-key
MAPBOX_ACCESS_TOKEN=replace-with-mapbox-access-token
GOOGLE_MAPS_API_KEY=replace-with-google-maps-api-key
